{
  "schemaVersion": 1,
  "key": "com.example.hello",
  "name": "Hello plugin",
  "version": "1.0.0",
  "description": "Logs issue and comment events and shows a small panel on issues.",
  "vendor": { "name": "Example Inc.", "url": "https://example.com" },
  "baseUrl": "https://hello-plugin.example.com",
  "scopes": ["read:issues"],
  "events": ["issue.created", "issue.updated", "issue.transitioned", "comment.added"],
  "webhookPath": "/veqsio/events",
  "config": [
    { "key": "greeting", "label": "Greeting", "type": "text", "required": false }
  ],
  "uiPanels": [
    { "location": "issue.sidebar", "title": "Hello", "path": "/panel" }
  ]
}
