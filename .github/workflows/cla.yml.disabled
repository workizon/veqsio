# DISABLED on purpose: GitHub only runs *.yml and *.yaml files. CLA.md has not been reviewed by a lawyer yet, so external pull requests are not accepted.
# To switch the bot on after the review: rename this file back to cla.yml, create the `cla-signatures` branch, and add the secret CLA_PAT if `main` is protected.

name: CLA

# Asks every new contributor to sign CLA.md once. Signatures are stored on a separate branch.
# One-time setup by a repository admin: create the `cla-signatures` branch, and if the default branch is protected
# add a personal access token with repo scope as the secret CLA_PAT (the default GITHUB_TOKEN cannot push to
# protected branches).

on:
  issue_comment:
    types: [created]
  pull_request_target:
    types: [opened, closed, synchronize]

permissions:
  actions: write
  contents: write
  pull-requests: write
  statuses: write

jobs:
  cla:
    runs-on: ubuntu-latest
    if: >
      (github.event.comment.body == 'recheck' ||
       github.event.comment.body == 'I have read the CLA Document and I hereby sign the CLA') ||
      github.event_name == 'pull_request_target'
    steps:
      - name: CLA assistant
        # Pinned release. Runs with pull_request_target, so it never checks out or executes the PR's code.
        uses: contributor-assistant/github-action@v2.6.1
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          PERSONAL_ACCESS_TOKEN: ${{ secrets.CLA_PAT || secrets.GITHUB_TOKEN }}
        with:
          path-to-signatures: 'signatures/v1/cla.json'
          path-to-document: 'https://github.com/workizon/veqsio/blob/main/CLA.md'
          branch: 'cla-signatures'
          allowlist: 'workizon,born2hate,dependabot[bot],github-actions[bot]'
          custom-notsigned-prcomment: 'Thank you for your contribution. Before we can merge it, please sign the Contributor License Agreement once (it covers all your future contributions).'
