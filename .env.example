# ============================================
# Veqsio (Jira Clone) — Environment Variables
# ============================================
# Copy this file to .env and fill in all required values before deploying.
# ./deploy.sh validates that critical variables are set.

# --- Database ---
# Full connection string used by the API and drizzle-kit
DATABASE_URL=postgresql://veqsio:veqsio@localhost:5460/veqsio

# --- Redis ---
# Full connection string used by the API for caching, sessions, rate limiting, queues
REDIS_URL=redis://localhost:6381

# --- Meilisearch ---
# Optional: enables fast typo-tolerant full-text search
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=your_master_key

# --- API (backend) ---
# Port the API Bun server listens on inside the container
PORT=3000
API_PORT=3000

# --- Nginx (reverse proxy) ---
# Override if ports 80/443 are already in use on the host
NGINX_HTTP_PORT=3060
NGINX_HTTPS_PORT=443

# --- Web (frontend / Next.js) ---
# Public URL the browser will call for API requests
NEXT_PUBLIC_API_URL=http://localhost:3060

# --- Production URLs ---
# External URLs used for CORS, email links, callback URLs, etc.
WEB_URL=https://jira.wup.lv
BASE_URL=https://jira.wup.lv

# --- Enterprise identity ---
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts OIDC client secrets at rest.
# REQUIRED in production: saving an OIDC provider fails without it.
SECRETS_ENCRYPTION_KEY=
# Public base URL the identity provider redirects back to (defaults to WEB_URL)
OIDC_REDIRECT_BASE_URL=
# Personal access token expiry policy (days)
PAT_DEFAULT_EXPIRY_DAYS=90
PAT_MAX_EXPIRY_DAYS=365

# --- PostgreSQL (used by docker-compose) ---
POSTGRES_USER=veqsio
POSTGRES_PASSWORD=change_me_in_env
POSTGRES_DB=veqsio

# --- Storage (S3-compatible, e.g. Cloudflare R2 / AWS S3 / MinIO) ---
# Set STORAGE_TYPE=mock for local disk storage (requires uploads volume)
STORAGE_TYPE=r2
STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
STORAGE_BUCKET=veqsio-attachments
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=https://cdn.example.com
STORAGE_REGION=auto
STORAGE_MAX_FILE_SIZE=104857600

# --- Email (SMTP) ---
# Required for password resets, notifications, and outgoing mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TLS=true

# --- SSL / Let's Encrypt ---
# Domain for the application (used by certbot and nginx)
VEQSIO_DOMAIN=jira.wup.lv
# Contact email for Let's Encrypt certificate registration
VEQSIO_SSL_EMAIL=admin@wup.lv

# --- Monitoring (Prometheus + Grafana) ---
# Grafana admin credentials (change in production)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_in_env
# External root URL for Grafana (used for redirects)
GRAFANA_ROOT_URL=https://jira.wup.lv/grafana

# --- Backup ---
# Optional: S3/R2-compatible remote backup target
# If all four are set, backup.sh will sync dumps automatically.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# --- CI/CD / Deploy ---
# Git repository URL and branch for the self-hosted deploy pipeline
VEQSIO_REPO_URL=https://github.com/workizon/veqsio.git
VEQSIO_BRANCH=main

# Customer portal abuse limits (per user, per desk, per hour) and upload size
PORTAL_MAX_REQUESTS_PER_HOUR=20
PORTAL_MAX_COMMENTS_PER_HOUR=60
PORTAL_MAX_UPLOADS_PER_HOUR=60
PORTAL_MAX_ATTACHMENT_BYTES=10485760

# --- Operations (docs/observability.md, docs/multi-node.md, docs/backup-and-recovery.md) ---
# Bearer token that enables GET /metrics (Prometheus). Unset = endpoint disabled (404).
METRICS_TOKEN=
# json (default) | text | raw; level: debug | info | warn | error | silent
LOG_LEVEL=info
LOG_FORMAT=json
# all (default) | web | worker: where HTTP is served and where background jobs run
VEQSIO_ROLE=all
# Backups: directory holding last-backup.json / last-verify.json (read by the API), retention
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
