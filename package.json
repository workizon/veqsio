{
  "name": "veqsio",
  "version": "1.3.1",
  "license": "AGPL-3.0-only",
  "private": true,
  "workspaces": [
    "packages/*",
    "modules/*",
    "ee/modules/*"
  ],
  "scripts": {
    "build": "bun run --filter='*' build",
    "lint": "bun run --filter='*' lint",
    "test": "bun run --filter='*' test",
    "test:api": "cd packages/api && bun test",
    "test:e2e": "cd packages/web && npx playwright test"
  }
}
