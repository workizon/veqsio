# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js
.next/
out/

# Production builds
dist/
build/

# Environment variables
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database (migrations under packages/db/drizzle ARE tracked)
drizzle/
!/packages/db/drizzle/
*.db
*.sqlite

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Testing
coverage/
*.test.ts.snap

# Misc
*.tmp
*.temp
cookies.txt

# Deploy credentials (server-local, never in repo)
.deploy-key
.deploy-key.pub

# Agent/tool state
.swarm/

# Build artifacts
*.tsbuildinfo

# Runtime data and TLS material (created on server at deploy time)
backups/
nginx/ssl/
nginx/certbot/
nginx/certbot-www/
nginx/logs/


# Generated by install.sh
/.install/
/.admin-credentials

# Generated by packages/web/scripts/gen-module-registry.ts (static imports of bundled module web entries)
packages/web/lib/module-registry.generated.ts

# local Redis dumps
dump.rdb

# Secrets and private data that must never be committed: licence signing keys, certificates, database files and dumps
*.pem
*.private.pem
*.private.key
keys/
license-keys/
/data/
/nginx/ssl/
/nginx/certbot/
/nginx/logs/
*.dump
*.sql.gz

# Release hygiene: never publish keys, runtime data, backups or logs
*.pem
*.key
**/keys/
/data/
/backups/
*.dump
*.rdb
*.sql.gz
*.tar.gz
*.zip
/nginx/logs/
/nginx/ssl/*
/nginx/certbot/
/nginx/certbot-www/
*.bak
*.bak-*
.admin-credentials

# =====================================================================================================================

# Paid modules live in a separate private repository; only the empty placeholder ee/.gitkeep is tracked so that
# the Dockerfiles (COPY ee ./ee) and the workspace globs work in a plain checkout.
/ee/*
!/ee/.gitkeep
